    /* ==========================================================================
       СОСТОЯНИЕ ИГРЫ
       ========================================================================== */
    let gameState = {
      hackedNodes: new Set(),
      activeTaskIndex: null,
      shields: 3,
      totalMistakes: 0,
      soundEnabled: true
    };

    /* ==========================================================================
       ЗВУКОВОЙ ДВИЖОК: WEB AUDIO API
       ========================================================================== */
    class SoundEngine {
      constructor() {
        this.ctx = null;
      }
      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playClick() {
        if (!gameState.soundEnabled) return;
        this.init();
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, this.ctx.currentTime + 0.05);
        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.05);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.05);
      }

      playSuccess() {
        if (!gameState.soundEnabled) return;
        this.init();
        // Футуристический мажорный арпеджио-аккорд
        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        notes.forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.06);
          gain.gain.setValueAtTime(0.15, this.ctx.currentTime + idx * 0.06);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + idx * 0.06 + 0.35);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(this.ctx.currentTime + idx * 0.06);
          osc.stop(this.ctx.currentTime + idx * 0.06 + 0.4);
        });
      }

      playError() {
        if (!gameState.soundEnabled) return;
        this.init();
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(140, this.ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(80, this.ctx.currentTime + 0.25);
        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.25);
      }
    }

    const sound = new SoundEngine();

    /* ==========================================================================
       SVG ИКОНКИ МИКРОЧИПОВ
       ========================================================================== */
    function getChipSVG(isHacked) {
      return `
        <svg viewBox="0 0 64 64" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Корпус микрочипа -->
          <rect x="14" y="14" width="36" height="36" rx="6" fill="${isHacked ? 'rgba(0,245,212,0.1)' : 'rgba(255,255,255,0.03)'}"/>
          <!-- Внутреннее ядро -->
          <rect x="23" y="23" width="18" height="18" rx="3" fill="${isHacked ? '#00f5d4' : 'rgba(0,245,212,0.2)'}" stroke="none"/>
          <!-- Контакты чипа -->
          <line x1="20" y1="6" x2="20" y2="14"/>
          <line x1="32" y1="6" x2="32" y2="14"/>
          <line x1="44" y1="6" x2="44" y2="14"/>
          <line x1="20" y1="50" x2="20" y2="58"/>
          <line x1="32" y1="50" x2="32" y2="58"/>
          <line x1="44" y1="50" x2="44" y2="58"/>
          <line x1="6" y1="20" x2="14" y2="20"/>
          <line x1="6" y1="32" x2="14" y2="32"/>
          <line x1="6" y1="44" x2="14" y2="44"/>
          <line x1="50" y1="20" x2="58" y2="20"/>
          <line x1="50" y1="32" x2="58" y2="32"/>
          <line x1="50" y1="44" x2="58" y2="44"/>
        </svg>
      `;
    }

    /* ==========================================================================
       ИНИЦИАЛИЗАЦИЯ И ОТРИСОВКА СЕТКИ
       ========================================================================== */
    const nodesGrid = document.getElementById('nodesGrid');
    const modalOverlay = document.getElementById('modalOverlay');
    const terminalWindow = document.getElementById('terminalWindow');
    const progressFill = document.getElementById('progressBar');
    const progressPct = document.getElementById('progressPct');
    const nodesCount = document.getElementById('nodesCount');

    function renderGrid() {
      nodesGrid.innerHTML = '';
      TASKS.forEach((task, idx) => {
        const isHacked = gameState.hackedNodes.has(task.id);
        const card = document.createElement('div');
        card.className = `node-card ${isHacked ? 'hacked' : ''}`;
        card.innerHTML = `
          <div class="node-status-tag">${isHacked ? '✓ HACKED' : 'LOCKED'}</div>
          <div class="node-icon-wrap">${getChipSVG(isHacked)}</div>
          <div class="node-id">NODE_${task.id < 10 ? '0' + task.id : task.id}</div>
          <div class="node-topic">${task.topic}</div>
        `;
        card.addEventListener('click', () => {
          sound.playClick();
          openNodeModal(idx);
        });
        nodesGrid.appendChild(card);
      });
      updateStats();
    }

    function updateStats() {
      const hackedTotal = gameState.hackedNodes.size;
      const pct = Math.round((hackedTotal / TASKS.length) * 100);
      progressFill.style.width = `${pct}%`;
      progressPct.textContent = `${pct}%`;
      nodesCount.textContent = `${hackedTotal} / ${TASKS.length}`;

      if (hackedTotal === TASKS.length) {
        setTimeout(showFinalSuccess, 700);
      }
    }

    /* ==========================================================================
       ЛОГИКА ТЕРМИНАЛА / ВОПРОСОВ
       ========================================================================== */
    function openNodeModal(taskIndex) {
      gameState.activeTaskIndex = taskIndex;
      gameState.shields = 3;
      updateShieldUI();

      const task = TASKS[taskIndex];
      const isAlreadyHacked = gameState.hackedNodes.has(task.id);

      document.getElementById('terminalNodeTitle').textContent = `ACCESS_POINT // NODE_${task.id < 10 ? '0' + task.id : task.id}`;
      document.getElementById('questionText').innerHTML = task.question;
      document.getElementById('feedbackMsg').innerHTML = isAlreadyHacked 
        ? '<span class="feedback-correct">✓ УЗЕЛ УЖЕ ДЕШИФРОВАН. ДОСТУП ПРЕДОСТАВЛЕН.</span>' 
        : '';

      const container = document.getElementById('answersContainer');
      container.innerHTML = '';

      task.answers.forEach((ans, ansIdx) => {
        const btn = document.createElement('button');
        btn.className = 'ans-btn';
        if (isAlreadyHacked && ansIdx === task.correct) {
          btn.classList.add('correct');
        }
        btn.innerHTML = `
          <span class="ans-key">${String.fromCharCode(65 + ansIdx)}</span>
          <span>${ans}</span>
        `;
        btn.disabled = isAlreadyHacked;
        btn.addEventListener('click', () => handleAnswer(ansIdx, btn));
        container.appendChild(btn);
      });

      modalOverlay.classList.add('active');
    }

    function updateShieldUI() {
      const shieldBox = document.getElementById('shieldDisplay');
      let hearts = '';
      for (let i = 0; i < 3; i++) {
        hearts += (i < gameState.shields) ? '🛡️' : '🩶';
      }
      shieldBox.innerHTML = `<span>ЩИТ:</span> <span>${hearts}</span>`;
    }

    function handleAnswer(choiceIdx, buttonElem) {
      const task = TASKS[gameState.activeTaskIndex];
      const allButtons = document.querySelectorAll('.ans-btn');
      const feedback = document.getElementById('feedbackMsg');

      if (choiceIdx === task.correct) {
        /* ВЕРНЫЙ ОТВЕТ */
        sound.playSuccess();
        buttonElem.classList.add('correct');
        allButtons.forEach(b => b.disabled = true);
        feedback.innerHTML = `<span class="feedback-correct">✓ КЛЮЧ ПРИНЯТ: Доступ к памяти NODE_${task.id} открыт!</span>`;
        
        gameState.hackedNodes.add(task.id);
        spawnBinaryRain(22);

        setTimeout(() => {
          closeModal();
          renderGrid();
        }, 1100);

      } else {
        /* ОШИБКА */
        sound.playError();
        gameState.totalMistakes++;
        gameState.shields--;
        buttonElem.classList.add('wrong');
        terminalWindow.classList.add('shake-anim');
        setTimeout(() => terminalWindow.classList.remove('shake-anim'), 500);

        updateShieldUI();

        if (gameState.shields <= 0) {
          feedback.innerHTML = `<span class="feedback-wrong">✕ ЩИТ ИСЧЕРПАН! Подсказка: ${task.hint}</span>`;
          // Сброс щита для продолжения практики
          gameState.shields = 3;
          setTimeout(updateShieldUI, 2000);
        } else {
          feedback.innerHTML = `<span class="feedback-wrong">✕ ОШИБКА АВТОРИЗАЦИИ! Попробуйте другой вариант.</span>`;
        }

        setTimeout(() => {
          buttonElem.classList.remove('wrong');
        }, 1200);
      }
    }

    function closeModal() {
      modalOverlay.classList.remove('active');
    }

    document.getElementById('modalCloseBtn').addEventListener('click', closeModal);
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });

    /* ==========================================================================
       БИНАРНЫЙ САЛЮТ (ЦЕМЕНТИРОВАНИЕ ПОБЕДЫ)
       ========================================================================== */
    function spawnBinaryRain(count = 20) {
      for (let i = 0; i < count; i++) {
        const span = document.createElement('span');
        span.className = 'binary-particle';
        span.textContent = Math.random() > 0.5 ? '1' : '0';
        span.style.left = `${Math.random() * 96 + 2}vw`;
        span.style.top = `-20px`;
        span.style.fontSize = `${Math.floor(Math.random() * 14) + 14}px`;
        span.style.animationDuration = `${(Math.random() * 1.5 + 2).toFixed(2)}s`;
        document.body.appendChild(span);
        setTimeout(() => span.remove(), 3200);
      }
    }

    /* ==========================================================================
       ФИНАЛЬНОЕ ОКНО ПОБЕДЫ
       ========================================================================== */
    function showFinalSuccess() {
      const accuracy = Math.max(50, Math.round((12 / (12 + gameState.totalMistakes)) * 100));
      document.getElementById('finalStats').textContent = `ТОЧНОСТЬ ДЕШИФРАЦИИ: ${accuracy}% (Ошибок: ${gameState.totalMistakes})`;
      document.getElementById('successModal').classList.add('active');
      spawnBinaryRain(40);
    }

    function resetGame() {
      sound.playClick();
      gameState.hackedNodes.clear();
      gameState.activeTaskIndex = null;
      gameState.shields = 3;
      gameState.totalMistakes = 0;
      document.getElementById('successModal').classList.remove('active');
      closeModal();
      renderGrid();
    }

    /* ==========================================================================
       УПРАВЛЕНИЕ: ЗВУК, FULLSCREEN, СБРОС
       ========================================================================== */
    const audioToggleBtn = document.getElementById('audioToggleBtn');
    audioToggleBtn.addEventListener('click', () => {
      gameState.soundEnabled = !gameState.soundEnabled;
      document.getElementById('audioIcon').textContent = gameState.soundEnabled ? '🔊' : '🔇';
      audioToggleBtn.innerHTML = `<span id="audioIcon">${gameState.soundEnabled ? '🔊' : '🔇'}</span> ЗВУК: ${gameState.soundEnabled ? 'ВКЛ' : 'ВЫКЛ'}`;
      if (gameState.soundEnabled) sound.playClick();
    });

    const fullscreenBtn = document.getElementById('fullscreenBtn');
    fullscreenBtn.addEventListener('click', () => {
      sound.playClick();
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
        fullscreenBtn.textContent = '⊡ СВЕРНУТЬ';
      } else {
        document.exitFullscreen().catch(() => {});
        fullscreenBtn.textContent = '⛶ ПОЛНЫЙ ЭКРАН';
      }
    });

    document.getElementById('resetBtn').addEventListener('click', () => {
      if (confirm('Сбросить текущий прогресс дешифровки?')) {
        resetGame();
      }
    });

    // Старт
    renderGrid();
  </script>
